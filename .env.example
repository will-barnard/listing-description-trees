DB_PASSWORD=

# Random secret used to sign session JWTs. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# Set to true to bypass auth entirely (local dev only — never use in production)
AUTH_DISABLED=false
AUTH_COOKIE_NAME=auth_token

# API token(s) for programmatic clients (Claude / MCP / scripts). Sent as
# `Authorization: Bearer <token>` and authenticated as a service admin.
# Comma-separate multiple tokens to rotate without downtime. Generate one with:
#   openssl rand -hex 32
API_TOKEN=
